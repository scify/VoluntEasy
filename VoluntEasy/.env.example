APP_NAME=VoluntEasy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Athens

# Name shown in page titles and e-mails (for example VoluntEasy or VoluntAction)
PLATFORM_NAME=VoluntEasy

# Deployment flavour: scify, municipality or ekpizo
MODE=scify

# Default language: en or el
APP_LOCALE=el
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=volunteasy
DB_USERNAME=volunteasy
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${PLATFORM_NAME}"
